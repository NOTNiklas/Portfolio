---
import Layout from '../../../layouts/Layout.astro';
import InkArt from '../../../components/InkArt.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { useTexts, pick, url, langPaths, otherLang, fill, type Lang } from '../../../lib/i18n';
import { getProjects, getSpotlight } from '../../../lib/content';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useTexts(lang);
const projects = await getProjects();
const spotlight = await getSpotlight();
const filterIds = ['all', 'unreal', 'godot', 'jam', 'tool'] as const;
const count = (n: number) => (n === 1 ? t.projects.count_one : fill(t.projects.count_many, { n }));
---

<Layout lang={lang} title={t.projects.title} active="projects" alternate={url(otherLang(lang), 'projects/')}>
  <section class="section" style="padding-bottom: 40px">
    <div class="container stack">
      <p class="eyebrow">{t.projects.eyebrow}</p>
      <h1 class="h1">{t.projects.heading}</h1>
      <p class="lead">{t.projects.intro}</p>
    </div>
  </section>

  <section class="section section--tight" style="padding-bottom: 40px">
    <a class="container spot" href={url(lang, `projects/${spotlight.id}/`)}>
      <div class="spot__text stack" style="--gap: 12px">
        <span class="eyebrow">{t.projects.featured} · {t.status[spotlight.data.status]}</span>
        <h2 class="h2"><span class="gold-text">{spotlight.data.title}</span></h2>
        <p class="muted">{pick(spotlight.data.summary, lang)}</p>
        <span class="spot__more">{t.projects.case_study} ›</span>
      </div>
      <div class="spot__art">
        <InkArt src={spotlight.data.keyArt} alt={spotlight.data.title} ratio="16 / 10" shadow={false} />
      </div>
    </a>
  </section>

  <section class="section section--tight">
    <div class="container stack" style="--gap: 24px">
      <div class="row row--between" style="align-items: center">
        <div class="row" style="--gap: 8px" role="group" aria-label={t.projects.filter_label}>
          {filterIds.map((id) => (
            <button class="filter" type="button" data-filter={id} aria-pressed={id === 'all' ? 'true' : 'false'}>
              {t.projects.filters[id]}
            </button>
          ))}
        </div>
        <p class="small muted" aria-live="polite" data-count data-one={t.projects.count_one} data-many={t.projects.count_many}>
          {count(projects.length)}
        </p>
      </div>
      <div class="grid grid--fill" data-list>
        {projects.map((p) => <ProjectCard project={p} lang={lang} detailed />)}
      </div>
    </div>
  </section>

  <section class="section section--parchment">
    <div class="container--narrow stack center">
      <h2 class="h2">{t.projects.cta_title}</h2>
      <p class="text-2">{t.projects.cta_text}</p>
      <a class="btn btn--gold" href={url(lang, 'devlog/')}>{t.projects.cta_button}</a>
    </div>
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-list] > [data-filters]');
  const counter = document.querySelector<HTMLElement>('[data-count]');
  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      const f = button.dataset.filter!;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      let shown = 0;
      cards.forEach((card) => {
        const match = f === 'all' || card.dataset.filters!.split(' ').includes(f);
        card.hidden = !match;
        if (match) shown++;
      });
      if (counter) {
        counter.textContent = shown === 1 ? counter.dataset.one! : counter.dataset.many!.replace('{n}', String(shown));
      }
    }),
  );
</script>

<style>
  .spot {
    display: flex; flex-wrap: wrap; background: var(--tile-1); color: #fff;
    border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--gold-line);
  }
  .spot:hover { text-decoration: none; border-color: var(--gold); }
  .spot__text { flex: 1 1 380px; padding: 40px; justify-content: center; }
  .spot__text .eyebrow { color: var(--gold-light); }
  .spot__text .muted { color: var(--on-dark-muted); }
  .spot__more { color: var(--gold-light); }
  .spot__art { flex: 1 1 420px; min-width: 0; }
  .spot__art :global(.ink) { height: 100%; border-radius: 0; }
</style>
