---
import Layout from '../layouts/Layout.astro';
import { useTexts } from '../lib/i18n';

const de = useTexts('de');
const en = useTexts('en');
---

<Layout lang="de" title="404" alternate="/en/" dark>
  <section class="section nf">
    <div class="container--narrow stack center" style="--gap: 20px">
      <div class="nf__art">
        <p aria-hidden="true">404</p>
        <svg aria-hidden="true" viewBox="0 0 520 200" preserveAspectRatio="none">
          <path d="M20 70 L 120 92 L 150 60 L 230 128 L 262 104 L 330 150 L 380 132 L 500 176" stroke="var(--gold)" stroke-width="5" stroke-linejoin="round" stroke-linecap="round"></path>
          <path class="seam-glint" d="M20 70 L 120 92 L 150 60 L 230 128 L 262 104 L 330 150 L 380 132 L 500 176" pathLength="100" stroke="var(--gold-shine)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M150 60 L 166 22 M 262 104 L 300 70 M 380 132 L 410 104" stroke="var(--gold)" stroke-width="3" stroke-linecap="round"></path>
        </svg>
      </div>
      <h1 class="h2 h2--lg">{de.not_found.title}</h1>
      <p class="lead" style="color: var(--on-dark-muted)">{de.not_found.text}</p>
      <div class="row center" style="--gap: 12px">
        <a class="btn btn--gold" href="/de/">{de.not_found.home}</a>
        <a class="btn btn--ghost" href="/de/projects/">{de.not_found.projects}</a>
      </div>
      <p class="small" lang="en" style="color: #a1a1a6">{en.not_found.title} <a href="/en/">{en.not_found.home} ›</a></p>
    </div>
  </section>
</Layout>

<style>
  .nf { padding-block: 96px 112px; color: #fff; }
  .nf a:not(.btn) { color: var(--gold-light); }
  .nf__art { position: relative; width: 100%; max-width: 520px; }
  .nf__art p { font-size: clamp(120px, 30vw, 200px); line-height: 1; font-weight: 600; letter-spacing: -6px; color: var(--paper); }
  .nf__art svg { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; }
</style>
