---
import { useTexts, url, otherLang, type Lang } from '../lib/i18n';
import { site } from '../lib/data';

interface Props {
  lang: Lang;
  active?: string;
  alternate: string;
}
const { lang, active, alternate } = Astro.props;
const t = useTexts(lang);
const other = otherLang(lang);

const links = [
  { id: 'projects', href: url(lang, 'projects/'), label: t.nav.projects },
  { id: 'career', href: url(lang, 'career/'), label: t.nav.career },
  { id: 'about', href: url(lang, 'about/'), label: t.nav.about },
  { id: 'devlog', href: url(lang, 'devlog/'), label: t.nav.devlog },
  { id: 'contact', href: url(lang, 'contact/'), label: t.nav.contact },
];
---

<header class="nav">
  <nav class="nav__inner" aria-label={t.nav.main}>
    <a class="nav__brand" href={url(lang)}>{site.name}</a>

    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-menu"
      data-open={t.nav.menu_open} data-close={t.nav.menu_close} aria-label={t.nav.menu_open}>
      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <path class="nav__icon-open" d="M4 8 H20 M4 16 H20"></path>
        <path class="nav__icon-close" d="M6 6 L18 18 M18 6 L6 18"></path>
      </svg>
    </button>

    <div class="nav__menu" id="nav-menu">
      <ul class="nav__links">
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={active === l.id ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
      <div class="nav__lang" role="group" aria-label={t.nav.language}>
        <a href={lang === 'de' ? alternate : url('en')} lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        <span aria-hidden="true">/</span>
        <a href={lang === 'en' ? alternate : url('de')} lang="de" aria-current={lang === 'de' ? 'true' : undefined}>DE</a>
      </div>
      <a class="nav__cv" href={`${url(lang, 'career/')}#cv`}><span class="btn btn--gold btn--sm">{t.nav.cv} ›</span></a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const header = document.querySelector('.nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', (open ? toggle.dataset.close : toggle.dataset.open) ?? '');
    header?.classList.toggle('is-open', open);
  });
</script>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: #000; color: #fff;
    border-bottom: 1px solid rgba(217, 164, 65, 0.45);
    font-size: 14px; letter-spacing: -0.224px;
  }
  .nav__inner {
    max-width: 1180px; margin: 0 auto; padding: 4px 24px; min-height: 52px;
    display: flex; align-items: center; gap: 28px;
  }
  .nav__brand { margin-right: auto; color: #fff; font-size: 17px; font-weight: 600; letter-spacing: -0.374px; }
  .nav__brand:hover { color: #fff; text-decoration: none; }
  .nav__menu { display: flex; align-items: center; gap: 28px; }
  .nav__links { display: flex; gap: 24px; }
  .nav__links a {
    display: flex; align-items: center; min-height: 44px;
    color: #ccc; border-top: 2px solid transparent; border-bottom: 2px solid transparent;
  }
  .nav__links a:hover { color: #fff; text-decoration: none; }
  .nav__links a[aria-current='page'] { color: #fff; border-bottom-color: var(--gold); }
  .nav__lang { display: flex; align-items: center; gap: 2px; font-size: 13px; color: var(--muted); }
  .nav__lang a { min-width: 32px; min-height: 44px; display: flex; align-items: center; justify-content: center; color: #a1a1a6; }
  .nav__lang a[aria-current='true'] { color: #fff; font-weight: 600; }
  .nav__lang a:hover { color: #fff; text-decoration: none; }
  .nav__cv { display: flex; align-items: center; min-height: 44px; }
  .nav__cv:hover { text-decoration: none; }
  .nav__toggle {
    display: none; width: 44px; height: 44px; border: 0; background: transparent; color: #fff; cursor: pointer;
    align-items: center; justify-content: center;
  }
  .nav__icon-close { display: none; }

  @media (max-width: 900px) {
    .nav__inner { padding: 0 8px 0 20px; flex-wrap: wrap; gap: 0; }
    .nav__toggle { display: flex; }
    .nav__menu {
      display: none; width: 100%; flex-direction: column; align-items: stretch; gap: 0;
      padding: 8px 12px 28px 0;
    }
    .nav.is-open .nav__menu { display: flex; }
    .nav.is-open .nav__icon-open { display: none; }
    .nav.is-open .nav__icon-close { display: inline; }
    .nav__links { flex-direction: column; gap: 0; }
    .nav__links a {
      min-height: 52px; font-size: 28px; font-weight: 600; color: #fff; letter-spacing: -0.2px;
      border-top: 0; border-bottom: 1px solid #1d1d1f;
    }
    .nav__links a[aria-current='page'] { color: var(--gold-light); border-bottom-color: #1d1d1f; }
    .nav__lang { padding-top: 16px; font-size: 14px; }
    .nav__lang a { min-width: 44px; }
    .nav__cv { padding-top: 8px; }
  }
</style>
