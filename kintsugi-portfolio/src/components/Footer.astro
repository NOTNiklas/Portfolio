---
import { useTexts, url, pick, type Lang } from '../lib/i18n';
import { site } from '../lib/data';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTexts(lang);
const year = new Date().getFullYear();

const pages = [
  { href: url(lang), label: t.nav.home },
  { href: url(lang, 'projects/'), label: t.nav.projects },
  { href: url(lang, 'career/'), label: t.nav.career },
  { href: url(lang, 'about/'), label: t.nav.about },
  { href: url(lang, 'devlog/'), label: t.nav.devlog },
];
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__grid">
      <div class="stack" style="--gap: 8px">
        <span class="footer__name">{site.name}</span>
        <p class="small muted">{t.footer.tagline}</p>
        <p class="small muted">{pick(site.location, lang)}</p>
      </div>
      <div>
        <h2>{t.footer.site}</h2>
        <ul>{pages.map((p) => <li><a href={p.href}>{p.label}</a></li>)}</ul>
      </div>
      <div>
        <h2>{t.footer.elsewhere}</h2>
        <ul>{site.socials.map((s) => <li><a href={s.url} rel="me noopener">{s.label} ›</a></li>)}</ul>
      </div>
      <div>
        <h2>{t.footer.contact}</h2>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={url(lang, 'contact/')}>{t.footer.form} ›</a></li>
          <li><a href={site.cv[lang]}>{t.footer.cv} ›</a></li>
        </ul>
      </div>
    </div>
    <div class="footer__bottom">
      <span>© {year} {site.name}. {t.footer.rights}</span>
      <span class="row" style="--gap: 20px">
        <a href="/impressum/">Impressum</a>
        <a href="/datenschutz/">Datenschutz</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--parchment); padding: 48px 24px 32px; letter-spacing: -0.224px; color: var(--ink); }
  .footer__inner { display: flex; flex-direction: column; gap: 32px; }
  .footer__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 32px; }
  .footer__name { font-size: 17px; font-weight: 600; letter-spacing: -0.374px; }
  .footer h2 { margin: 0 0 8px; font-size: 12px; font-weight: 600; }
  .footer ul { font-size: 14px; line-height: 2.2; }
  .footer ul a { color: var(--text-2); }
  .footer ul a:hover { color: var(--gold-deep); }
  .footer .muted { color: var(--muted); }
  .footer__bottom {
    border-top: 1px solid var(--gold); padding-top: 16px;
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px;
    font-size: 12px; color: var(--muted);
  }
  .footer__bottom a { color: var(--muted); }
</style>
