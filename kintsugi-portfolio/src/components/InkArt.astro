---
// Key Art: zeigt ein Bild, wenn eins angegeben ist, sonst die gezeichnete Tusche-Grafik.
interface Props {
  src?: string;
  alt?: string;
  ratio?: string;
  rounded?: 'all' | 'top';
  shadow?: boolean;
}
const { src = '', alt = '', ratio = '4 / 3', rounded = 'all', shadow = true } = Astro.props;
const crack = 'M20 180 L 140 205 L 175 160 L 260 230 L 300 210 L 390 300 L 455 285 L 540 360';
---

<div class:list={['ink', { 'ink--top': rounded === 'top', shadow }]} style={`--ratio: ${ratio}`}>
  {src ? (
    <img src={src} alt={alt} loading="lazy" />
  ) : (
    <svg aria-hidden="true" viewBox="0 0 560 420" preserveAspectRatio="xMidYMid slice">
      <path d="M0 330 C 90 280, 150 300, 220 250 S 360 230, 420 270 S 520 300, 560 280 L 560 420 L 0 420 Z" fill="#1d1d1f" opacity="0.12"></path>
      <path d="M0 360 C 120 320, 200 350, 300 310 S 470 330, 560 320 L 560 420 L 0 420 Z" fill="#1d1d1f" opacity="0.22"></path>
      <path d="M360 92 A 82 82 0 1 1 296 120" fill="none" stroke="#1d1d1f" stroke-width="16" stroke-linecap="round" opacity="0.85"></path>
      <path d={crack} fill="none" stroke="var(--gold)" stroke-width="3.5" stroke-linejoin="round" stroke-linecap="round"></path>
      <path class="seam-glint" d={crack} pathLength="100" fill="none" stroke="var(--gold-shine)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"></path>
      <path d="M175 160 L 190 110 M 300 210 L 330 170" fill="none" stroke="var(--gold)" stroke-width="2" stroke-linecap="round"></path>
    </svg>
  )}
</div>

<style>
  .ink { position: relative; aspect-ratio: var(--ratio); background: var(--paper); border-radius: var(--radius-lg); overflow: hidden; }
  .ink--top { border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
  .ink svg, .ink img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
</style>
